# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Las imágenes se sirven desde el worker (bucket R2 privado), no como asset
# estático, así que la regla de arriba no las cubre. La clave incluye un
# código de versión, por lo que la respuesta puede cachearse de forma
# inmutable en el edge.
/api/images/*
  Cache-Control: public,max-age=86400,s-maxage=31536000,immutable
